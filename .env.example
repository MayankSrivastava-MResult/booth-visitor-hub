# Copy to .env.local and fill in. Never commit .env.local. Never paste these values into chat.
# The same names (except MIGRATION_DATABASE_URL) go into Vercel → Project → Settings → Environment Variables.

# Runtime database connection used by the app. Supabase → Connect → Transaction pooler (port 6543),
# with the user changed to hub_api.<project-ref> and the hub_api password you chose. Keep ?sslmode=require.
DATABASE_URL=

# Used only on your machine to run migrations. Supabase → Connect → Session pooler (port 5432),
# user postgres.<project-ref> and the database password. NEVER put this one in Vercel.
MIGRATION_DATABASE_URL=

# Random secret used to hash IP addresses for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SECRET=
