{
  "name": "booth-visitor-hub",
  "private": true,
  "version": "0.1.0",
  "description": "MResult Booth Visitor Hub: visitor registration, touchpoints, Pharma Ninja integration and Excel export (GPPS 2026, Booth G1)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:gen-seed": "node scripts/gen-seed.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "admin:set-password": "node --env-file-if-exists=.env.local scripts/set-password.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
